flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Client([HTTP client]):::edge
        CLI(["CLI<br/>generate, report, serve"]):::edge
        Router["Router<br/>/validate, /generate"]:::edge
        Validate["Validation<br/>text cap, seed range"]:::control
        CLI ~~~ Client --> Router --> Validate
    end

    subgraph State["Data and state"]
        direction TB
        Schema[("Schema properties<br/>typed, ordered")]:::data
        Vocab[("Token vocabulary<br/>with end of sequence")]:::data
        Closure[("Closure cache<br/>lazy DFA states")]:::data
        Schema ~~~ Vocab
        Closure
    end

    subgraph Core["Compile and decode"]
        direction TB
        Pattern["schema_to_pattern<br/>compact JSON regex"]:::core
        Regex["Regex engine<br/>Thompson NFA, lazy DFA"]:::core
        Mask["Token mask<br/>avoid dead states"]:::control
        Model[["Model scores<br/>seeded or any scorer"]]:::edge
        Pick["Greedy pick<br/>best allowed token"]:::core
        Pattern --> Regex --> Mask --> Pick
        Pick -.->|scores| Model
    end

    subgraph Obs["Evaluation and outputs"]
        direction TB
        Doc["Generated document<br/>fullmatch checked"]:::obs
        Report["ValidityReport<br/>with vs without mask"]:::obs
        Metrics["ServiceMetrics<br/>Prometheus"]:::obs
        Doc --> Report ~~~ Metrics
    end

    Interfaces -->|seed or text| Core
    State -.->|schema, vocab| Core
    Core -->|tokens| Obs
